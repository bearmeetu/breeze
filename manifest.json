{
  "manifest_version": 3,
  "name": "Breeze AI",
  "version": "1.0",
  "description": "Intranet-friendly AI Assistant",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["github.min.css", "content.css"],
      "js": ["marked.min.js", "mermaid.min.js", "highlight.min.js", "content.js"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Breeze AI Settings"
  }
}
